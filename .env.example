# === LLM API 配置 (支持任意 OpenAI 兼容接口) ===
# 默认使用 DeepSeek 的配置，你可以随时替换为其他供应商（如 OpenAI, 硅基流动, OpenRouter 等）
TVC_API_KEY=your-api-key-here
TVC_API_BASE=https://api.deepseek.com

# === LangSmith Observability ===
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGSMITH_PROJECT=tvc-director-agent

# === 模型选择 (可选，切换供应商时需对应修改) ===
# DeepSeek 官方: deepseek-chat 或 deepseek-reasoner
# 硅基流动 DeepSeek: deepseek-ai/DeepSeek-V3 或 deepseek-ai/DeepSeek-R1
# OpenAI: gpt-4o 等
TVC_MODEL=deepseek-chat

# === PostgreSQL (仅 Docker 部署需要) ===
POSTGRES_DB=langgraph
POSTGRES_USER=langgraph
POSTGRES_PASSWORD=langgraph-secret-pw-change-me
LANGGRAPH_POSTGRES_URI=postgresql://langgraph:langgraph-secret-pw-change-me@postgres:5432/langgraph
